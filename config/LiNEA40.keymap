#define ZMK_POINTING_DEFAULT_SCRL_VAL 150

#include <dt-bindings/zmk/input_transform.h>
#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define MOUSE 1
#define MARK 2
#define CURSOR 3
#define FUNCTION 4
#define SCROLL 5
#define WIRELESS 6

//mouse cursol

&mmv {
    delay-ms = <20>;
    trigger-period-ms = <5>;
    time-to-max-speed-ms = <100>;
    acceleration-exponent = <2>;
};

//mouse scroll

&msc {
    delay-ms = <3>;
    trigger-period-ms = <3>;
    time-to-max-speed-ms = <100>;
    acceleration-exponent = <0>;
};

/ {
    input_processors {
        zip_wheel_scaler: zip_wheel_scaler {
            compatible = "zmk,input-processor-scaler";
            #input-processor-cells = <2>;
            type = <INPUT_EV_REL>;
            codes = <INPUT_REL_WHEEL>;
            track-remainders;
        };
    };
};

&msc_input_listener {
    speed_up {
        layers = <FUNCTION>;
        input-processors = <&zip_wheel_scaler 3 1>; //スクロールを3倍速にする
    };
};

&trackball_listener {
    scroller {
        layers = <SCROLL>;
        input-processors =
            <&zip_xy_transform INPUT_TRANSFORM_Y_INVERT>,
            //スクロール方向を逆転,,,,,,,,,,,,,,,,,,,
            <&zip_xy_to_scroll_mapper>;
    };
};

/ {
    combos {
        compatible = "zmk,combos";

        ZenkakuHankaku {
            bindings = <&kp GRAVE>;
            key-positions = <11 12>;
        };

        DeleteKey {
            bindings = <&kp DEL>;
            key-positions = <7 8>;
        };

        InsertKey {
            bindings = <&kp INS>;
            key-positions = <6 7>;
        };

        CenterClick {
            bindings = <&mkp MB3>;
            key-positions = <17 16>;
        };

        RightClick {
            bindings = <&mkp MB2>;
            key-positions = <18 17>;
        };

        PrevClick {
            bindings = <&mkp MB4>;
            key-positions = <27 28>;
        };

        ClickNext {
            bindings = <&mkp MB5>;
            key-positions = <26 27>;
        };
    };

    behaviors {
        re_kp: sensor_rotate_kp {
            compatible = "zmk,behavior-sensor-rotate-var";
            #sensor-binding-cells = <2>;
            bindings = <&kp>, <&kp>;
        };

        mouse_scrl: mouse_wheel_scrl {
            compatible = "zmk,behavior-sensor-rotate-var";
            #sensor-binding-cells = <2>;
            bindings = <&msc>, <&msc>;

            tap-ms = <20>;
        };
    };

    macros {
        MAIL: MAIL {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp H &kp I &kp R &kp O &kp N &kp O &kp B &kp U &kp DOT &kp Y &kp A &kp M &kp A &kp S &kp A &kp K &kp I &kp DOT &kp C &kp F>;
            label = "MAIL";
        };

        DOMAIN: DOMAIN {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LBKT &kp H &kp I &kp T &kp A &kp C &kp H &kp I &kp MINUS &kp S &kp Y &kp S &kp T &kp E &kp M &kp S &kp DOT &kp C &kp O &kp M>;
            label = "DOMAIN";
        };

        ID: ID {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp H &kp Y &kp A &kp M &kp A &kp LS(INTERNATIONAL_1) &kp N2 &kp N5 &kp C>;
            label = "ID";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp Q    &kp W  &kp E  &kp R   &kp T                                                              &kp Y        &kp U  &kp I                &kp O          &kp P
&lt 5 A  &kp S  &kp D  &kp F   &kp G                                                              &kp H        &kp J  &kp K                &kp L          &lt 5 MINUS
&kp Z    &kp X  &kp C  &kp V   &kp B                                                              &kp N        &kp M  &kp COMMA            &kp DOT        &kp SLASH
&mo 7    &mo 8  &mo 9  &trans  &lt 3 SPACE  &mt LEFT_SHIFT DELETE    &mt RIGHT_CONTROL BACKSPACE  &lt 4 ENTER         &lt 6 RIGHT_BRACKET  &kp BACKSLASH  &kp CAPS
            >;

            sensor-bindings = <&mouse_scrl SCRL_DOWN SCRL_UP>;
        };

        AML {
            bindings = <
&trans     &trans     &trans     &trans     &trans                              &kp LC(Y)  &trans    &trans    &trans    &kp LC(P)
&kp LC(A)  &kp LC(S)  &trans     &kp LC(F)  &trans                              &kp LC(H)  &mkp MB1  &mkp MB3  &mkp MB2  &mo 5
&kp LC(Z)  &kp LC(X)  &kp LC(C)  &kp LC(V)  &trans                              &trans     &mkp MB4  &mkp MB5  &kp UP    &to 0
&mo 7      &mo 8      &mo 9      &trans     &mo 2   &kp LEFT_SHIFT    &kp HOME  &kp END              &kp LEFT  &kp DOWN  &kp RIGHT
            >;

            sensor-bindings = <&mouse_scrl SCRL_DOWN SCRL_UP>;
        };

        MOUSE {
            bindings = <
&trans  &trans  &trans  &trans  &trans                    &trans  &trans    &trans    &trans    &trans
&trans  &trans  &trans  &trans  &trans                    &trans  &mkp MB1  &mkp MB3  &mkp MB2  &trans
&trans  &trans  &trans  &trans  &trans                    &trans  &trans    &trans    &trans    &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans            &trans    &trans    &trans
            >;
        };

        NUMBER {
            bindings = <
&kp ESC  &trans  &trans  &trans  &trans                            &kp INTERNATIONAL_3  &kp KP_NUMBER_7  &kp KP_NUMBER_8   &kp KP_NUMBER_9   &kp KP_PLUS
&kp TAB  &trans  &trans  &trans  &trans                            &kp LS(MINUS)        &kp KP_NUMBER_4  &kp KP_NUMBER_5   &kp KP_NUMBER_6   &kp KP_MINUS
&trans   &trans  &trans  &trans  &trans                            &kp KP_DOT           &kp KP_NUMBER_1  &kp KP_NUMBER_2   &kp KP_NUMBER_3   &kp KP_ASTERISK
&trans   &trans  &trans  &trans  &trans  &trans    &kp KP_NUMLOCK  &kp KP_NUMBER_0                       &kp LS(NUMBER_8)  &kp LS(NUMBER_9)  &kp KP_SLASH
            >;
        };

        FUNCTION {
            bindings = <
&kp LS(NUMBER_1)  &kp LS(NUMBER_2)  &kp LS(NUMBER_3)   &kp LS(NUMBER_4)  &kp LS(NUMBER_5)                                   &kp C_VOLUME_UP    &kp F7  &kp F8  &kp F9  &kp F10
&kp LS(NUMBER_6)  &kp LS(NUMBER_7)  &kp LS(NUMBER_8)   &kp LS(NUMBER_9)  &kp LEFT_BRACKET                                   &kp C_MUTE         &kp F4  &kp F5  &kp F6  &kp F11
&kp SEMICOLON     &kp SINGLE_QUOTE  &kp RIGHT_BRACKET  &kp BACKSLASH     &kp LS(INTERNATIONAL_1)                            &kp C_VOLUME_DOWN  &kp F1  &kp F2  &kp F3  &kp F12
&trans            &trans            &trans             &trans            &trans                   &kp LEFT_SHIFT    &trans  &trans                     &trans  &trans  &trans
            >;
        };

        SCROLL {
            bindings = <
&trans   &trans  &trans   &trans  &trans                         &trans         &trans  &trans  &trans  &trans
&kp TAB  &ID     &DOMAIN  &MAIL   &trans                         &trans         &trans  &trans  &trans  &trans
&trans   &trans  &trans   &trans  &trans                         &trans         &trans  &trans  &trans  &trans
&trans   &trans  &trans   &trans  &trans  &trans    &kp PAGE_UP  &kp PAGE_DOWN          &trans  &trans  &trans
            >;

            sensor-bindings = <&mouse_scrl SCRL_LEFT SCRL_RIGHT>;
        };

        WIRELESS {
            bindings = <
&bt BT_SEL 4  &bt BT_SEL 3  &bt BT_SEL 2  &bt BT_SEL 1  &bt BT_SEL 0                         &bt BT_SEL 0    &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
&trans        &trans        &trans        &trans        &trans                               &trans          &trans        &trans        &trans        &trans
&trans        &trans        &trans        &trans        &trans                               &trans          &trans        &trans        &trans        &bt BT_CLR
&trans        &trans        &trans        &trans        &trans        &trans    &bootloader  &studio_unlock                &trans        &trans        &bt BT_CLR_ALL
            >;
        };

        CONTROL {
            bindings = <
&trans     &trans     &trans     &trans     &trans                                  &kp LC(Y)    &trans  &trans        &trans        &kp LC(P)
&kp LC(A)  &kp LC(S)  &trans     &kp LC(F)  &trans                                  &kp LC(H)    &trans  &trans        &trans        &trans
&kp LC(Z)  &kp LC(X)  &kp LC(C)  &kp LC(V)  &trans                                  &trans       &trans  &trans        &kp LC(UP)    &trans
&trans     &trans     &trans     &trans     &trans  &kp LEFT_SHIFT    &kp LC(HOME)  &kp LC(END)          &kp LC(LEFT)  &kp LC(DOWN)  &kp LC(RIGHT)
            >;
        };

        WIN {
            bindings = <
&trans     &trans     &trans     &trans     &trans                            &kp LG(Y)  &trans     &trans        &trans        &kp LG(P)
&kp LG(A)  &kp LG(S)  &kp LG(D)  &kp LG(F)  &trans                            &kp LG(H)  &trans     &trans        &trans        &trans
&kp LG(Z)  &kp LG(X)  &kp LG(C)  &kp LG(V)  &trans                            &trans     &kp LG(M)  &trans        &kp LG(UP)    &trans
&trans     &trans     &trans     &trans     &trans  &kp LEFT_SHIFT    &trans  &trans                &kp LG(LEFT)  &kp LG(DOWN)  &kp LG(RIGHT)
            >;
        };

        ALT {
            bindings = <
&trans       &trans  &trans  &trans  &trans                            &trans         &trans      &trans  &kp PRINTSCREEN  &kp LA(PRINTSCREEN)
&kp LA(TAB)  &trans  &trans  &trans  &trans                            &trans         &kp LA(F4)  &trans  &trans           &trans
&trans       &trans  &trans  &trans  &trans                            &trans         &trans      &trans  &trans           &trans
&trans       &trans  &trans  &trans  &trans  &kp LEFT_SHIFT    &trans  &kp LA(ENTER)              &trans  &trans           &trans
            >;
        };
    };
};
