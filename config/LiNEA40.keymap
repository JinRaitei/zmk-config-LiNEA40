#define ZMK_POINTING_DEFAULT_SCRL_VAL 150

#include <dt-bindings/zmk/input_transform.h>
#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define MOUSE 1
#define MARK 2
#define CURSOR 3
#define FUNCTION 4
#define SCROLL 5
#define WIRELESS 6

//mouse cursol

&mmv {
    delay-ms = <20>;
    trigger-period-ms = <5>;
    time-to-max-speed-ms = <100>;
    acceleration-exponent = <2>;
};

//mouse scroll

&msc {
    delay-ms = <3>;
    trigger-period-ms = <3>;
    time-to-max-speed-ms = <100>;
    acceleration-exponent = <0>;
};

/ {
    input_processors {
        zip_wheel_scaler: zip_wheel_scaler {
            compatible = "zmk,input-processor-scaler";
            #input-processor-cells = <2>;
            type = <INPUT_EV_REL>;
            codes = <INPUT_REL_WHEEL>;
            track-remainders;
        };
    };
};

&msc_input_listener {
    speed_up {
        layers = <FUNCTION>;
        input-processors = <&zip_wheel_scaler 3 1>; //スクロールを3倍速にする
    };
};

&trackball_listener {
    scroller {
        layers = <SCROLL>;
        input-processors =
            <&zip_xy_transform INPUT_TRANSFORM_Y_INVERT>,
            //スクロール方向を逆転,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,
            <&zip_xy_to_scroll_mapper>;
    };
};

/ {
    combos {
        compatible = "zmk,combos";

        Wireless {
            bindings = <&mo 6>;
            key-positions = <37 34>;
        };

        Dot {
            bindings = <&kp PERIOD>;
            key-positions = <27 28>;
        };

        Underbar {
            bindings = <&kp INTERNATIONAL_1>;
            key-positions = <28 29>;
        };

        PrintScreen {
            bindings = <&kp PRINTSCREEN>;
            key-positions = <8 9>;
        };
    };

    behaviors {
        re_kp: sensor_rotate_kp {
            compatible = "zmk,behavior-sensor-rotate-var";
            #sensor-binding-cells = <2>;
            bindings = <&kp>, <&kp>;
        };

        mouse_scrl: mouse_wheel_scrl {
            compatible = "zmk,behavior-sensor-rotate-var";
            #sensor-binding-cells = <2>;
            bindings = <&msc>, <&msc>;

            tap-ms = <20>;
        };
    };

    macros {
        MAIL: MAIL {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp H &kp I &kp R &kp O &kp N &kp O &kp B &kp U &kp DOT &kp Y &kp A &kp M &kp A &kp S &kp A &kp K &kp I &kp DOT &kp C &kp F>;
            label = "MAIL";
        };

        DOMAIN: DOMAIN {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LBKT &kp H &kp I &kp T &kp A &kp C &kp H &kp I &kp MINUS &kp S &kp Y &kp S &kp T &kp E &kp M &kp S &kp DOT &kp C &kp O &kp M>;
            label = "DOMAIN";
        };

        ID: ID {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(F) &kp N9 &kp N9 &kp N0 &kp N0 &kp N4 &kp F &kp F &kp LBKT &kp LBKT>;
            label = "ID";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp Q                 &kp W             &kp E              &kp R   &kp T                                     &kp Y        &kp U  &kp I               &kp O               &kp P
&kp A                 &lt 5 S           &kp D              &kp F   &kp G                                     &kp H        &kp J  &kp K               &kp L               &kp MINUS
&mt LEFT_SHIFT Z      &kp X             &kp C              &kp V   &kp B                                     &kp N        &kp M  &kp COMMA           &kp UP              &mt RIGHT_SHIFT SLASH
&mt ESC LEFT_CONTROL  &mt TAB LEFT_GUI  &mt CAPS LEFT_ALT  &trans  &lt 3 SPACE  &kp DELETE    &kp BACKSPACE  &lt 4 ENTER         &mt RIGHT_ALT LEFT  &mt RIGHT_GUI DOWN  &mt RIGHT_CONTROL RIGHT
            >;

            sensor-bindings = <&mouse_scrl SCRL_DOWN SCRL_UP>;
        };

        AML {
            bindings = <
&trans  &trans  &trans  &trans  &trans                    &trans  &trans    &trans    &trans    &trans
&trans  &trans  &trans  &trans  &trans                    &trans  &mkp MB1  &mkp MB3  &mkp MB2  &trans
&trans  &trans  &trans  &trans  &trans                    &trans  &mkp MB4  &mkp MB5  &trans    &trans
&trans  &trans  &trans  &trans  &mo 2   &trans    &trans  &trans            &to 0     &trans    &trans
            >;
        };

        SML {
            bindings = <
&trans  &trans  &trans  &trans  &trans                    &trans  &trans    &trans    &trans    &trans
&trans  &trans  &trans  &trans  &trans                    &trans  &mkp MB1  &mkp MB3  &mkp MB2  &trans
&trans  &trans  &trans  &trans  &trans                    &trans  &mkp MB4  &mkp MB5  &trans    &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans            &trans    &trans    &trans
            >;
        };

        NUMBER {
            bindings = <
&kp LS(NUMBER_1)  &kp LS(NUMBER_2)  &kp LS(NUMBER_3)   &kp LS(NUMBER_4)  &kp LS(NUMBER_5)                                   &kp INTERNATIONAL_3  &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9  &kp KP_PLUS
&kp LS(NUMBER_6)  &kp LS(NUMBER_7)  &kp LS(NUMBER_8)   &kp LS(NUMBER_9)  &kp LEFT_BRACKET                                   &kp LS(NUMBER_8)     &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6  &kp KP_MINUS
&kp SEMICOLON     &kp SINGLE_QUOTE  &kp RIGHT_BRACKET  &kp BACKSLASH     &kp LS(INTERNATIONAL_1)                            &kp LS(NUMBER_9)     &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3  &kp KP_ASTERISK
&trans            &trans            &trans             &trans            &trans                   &trans    &kp KP_NUMLOCK  &kp KP_NUMBER_0                       &kp KP_DOT       &kp LS(MINUS)    &kp KP_SLASH
            >;
        };

        FUNCTION {
            bindings = <
&kp F1            &kp F2  &kp F3  &kp F4  &kp F5                    &kp F6  &kp F7  &kp F8    &kp F9         &kp F10
&trans            &trans  &trans  &trans  &trans                    &trans  &trans  &trans    &trans         &kp F11
&trans            &trans  &trans  &trans  &trans                    &trans  &trans  &trans    &kp PAGE_UP    &kp F12
&kp LEFT_CONTROL  &trans  &trans  &trans  &trans  &trans    &trans  &trans          &kp HOME  &kp PAGE_DOWN  &kp END
            >;
        };

        SCROLL {
            bindings = <
&trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans             &trans      &trans
&trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans             &trans      &trans
&trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans             &trans      &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans          &kp C_VOLUME_DOWN  &kp C_MUTE  &kp C_VOLUME_UP
            >;

            sensor-bindings = <&mouse_scrl SCRL_LEFT SCRL_RIGHT>;
        };

        WIRELESS {
            bindings = <
&trans   &trans  &trans   &trans  &trans                         &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2    &bt BT_SEL 3  &bt BT_SEL 4
&kp TAB  &ID     &DOMAIN  &MAIL   &trans                         &trans        &trans        &trans          &trans        &trans
&trans   &trans  &trans   &trans  &trans                         &trans        &trans        &trans          &trans        &bt BT_CLR
&trans   &trans  &trans   &trans  &trans  &trans    &bootloader  &trans                      &studio_unlock  &trans        &bt BT_CLR_ALL
            >;
        };
    };
};
